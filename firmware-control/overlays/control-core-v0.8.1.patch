-fn check_uses(emu: &Emulator, what: &str, gpio: u8, want: &[u8]) -> Result<(), String> {
-    let info = query(emu, what, gpio)?;
-    let want = want.iter().fold(0u32, |uses, &u| uses | (1 << u));
-    if info.uses == want {
-        Ok(())
-    } else {
-        Err(format!(
-            "{what}: GPIO {gpio} uses 0x{:02X}, want 0x{want:02X}",
-            info.uses
-        ))
-    }
