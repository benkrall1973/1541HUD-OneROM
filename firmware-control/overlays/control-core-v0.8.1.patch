-pub fn test_gpio_claims(emu: &Emulator, board: Board) -> Result<(), String> {
-    let saved = emu.gpio_claims();
-    let result = gpio_claims(emu, board);
-    emu.set_gpio_claims(saved);
-    emu.set_calling_plugin(SYSTEM);
-    result
