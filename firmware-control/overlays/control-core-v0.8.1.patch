-/// `board`'s X pins wired to more than one GPIO.
-pub fn dual_wired_x_pins(board: Board) -> Vec<&'static [u8]> {
-    [1, 2]
-        .into_iter()
-        .map(|x_pin| board.gpios_for_x_pin(x_pin))
-        .filter(|gpios| gpios.len() > 1)
-        .collect()
-}
