-        // embassy-rp leaves the pad's pull-down on.  An RX line nothing drives
-        // would then read as a break.
-        pac::PADS_BANK0.gpio(usize::from(rx)).modify(|w| {
-            w.set_pde(false);
-            w.set_pue(true);
-        });
